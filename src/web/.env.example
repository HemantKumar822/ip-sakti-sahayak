# IP-SAKTI Sahayak Frontend Environment Variables

# The base URL of the FastAPI backend.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# The API Key required to authenticate against the backend.
# This must match one of the keys in the backend's VALID_API_KEYS configuration.
# For the Corpus admin view it must additionally match VALID_ADMIN_API_KEYS
# (local dev uses the same key for both: dev-api-key-12345).
VITE_API_KEY=dev-api-key-12345
