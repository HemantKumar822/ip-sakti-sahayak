# Environment Configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit secrets.

# ─── LLM ───────────────────────────────────────────────
# Google AI API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. Switch to gemini-1.5-flash-8b if rate limited.
GEMINI_MODEL=gemini-1.5-flash

# Temperature: 0.0 = deterministic (recommended for legal). Max 1.0.
GEMINI_TEMPERATURE=0.1

# Max tokens in generation response.
GEMINI_MAX_OUTPUT_TOKENS=2048

# ─── EMBEDDINGS ────────────────────────────────────────
# sentence-transformers model for embedding. Must match what was used during ingestion.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── VECTOR STORE ──────────────────────────────────────
# ChromaDB collection name.
CHROMA_COLLECTION_NAME=ip_sakti_corpus

# Directory where ChromaDB persists its data.
CHROMA_PERSIST_DIR=./corpus/embeddings

# ─── PIPELINE ──────────────────────────────────────────
# Pipeline similarity score threshold. Queries below this score trigger abstention.
# Range: 0.0 (abstain always) to 1.0 (never abstain). Default: 0.65.
CONFIDENCE_THRESHOLD=0.65

# Number of top chunks returned by retriever per query.
RETRIEVAL_TOP_K=5

# Similarity score threshold for ABS (Access and Benefit Sharing) biological resource check.
# Default: 0.55.
ABS_THRESHOLD=0.55

# ─── CORPUS ────────────────────────────────────────────
# Path to corpus manifest JSON file.
CORPUS_MANIFEST_PATH=./corpus/manifest.json

# Directory where raw fetched documents are stored.
CORPUS_RAW_DIR=./corpus/raw

# ─── PRIVACY ───────────────────────────────────────────
# Enable PII stripping before logging. Set to false only for local debug.
PII_STRIP_ENABLED=true

# ─── SESSION & PERSISTENCE ─────────────────────────────
# Path to SQLite session database file.
SESSION_DB_PATH=./corpus/sessions.db

# Hard turn limit ceiling per conversational session.
MAX_SESSION_TURNS=6

# ─── SERVER ────────────────────────────────────────────
# FastAPI server bind address and port.
API_HOST=0.0.0.0
API_PORT=8000

# Default jurisdiction for routing (MVP: India only).
DEFAULT_JURISDICTION=India

# ─── ADVISORY & DISCLAIMERS ────────────────────────────
# Legal disclaimer attached to every response (DPDP Act and legal compliance).
DISCLAIMER_TEXT="This information is provided for general awareness and does not constitute legal advice. Consult a qualified IP attorney for decisions specific to your situation."

# Default message returned when similarity score falls below CONFIDENCE_THRESHOLD.
ABSTENTION_MESSAGE="The system cannot provide a confident advisory based on available legal corpus. Please consult an IP professional."

